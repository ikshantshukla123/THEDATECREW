# ─────────────── Dependencies ───────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─────────────── Next.js ───────────────
.next/
out/
build/
dist/
next-env.d.ts

# ─────────────── Environment ───────────────
# Never commit real credentials. .env.example IS committed.
.env
.env.*
!.env.example

# ─────────────── Prisma ───────────────
# Generated client (regenerated by `prisma generate` on install/build).
# Migrations ARE committed — do not add prisma/migrations here.
prisma/generated/
src/generated/
*.db
*.db-journal
dev.db*

# ─────────────── Testing ───────────────
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
blob-report/
.vitest-cache/

# ─────────────── Tooling caches ───────────────
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo/
.cache/
.swc/

# ─────────────── Deployment ───────────────
.vercel/
.netlify/

# ─────────────── Logs ───────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ─────────────── Editors ───────────────
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ─────────────── OS ───────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─────────────── Local scratch ───────────────
# Scratch space for throwaway scripts, SQL dumps, screenshots.
/scratch/
/tmp/
*.local.*

# ─────────────── Markdown / internal docs ───────────────
# Agent files and scratch notes stay local; the design docs ship.
*.md
!README.md
!ARCHITECTURE.md
!UI-UX.md

# ─────────────── Source images ───────────────
# Full-size PNG originals. Only the optimized WebP in public/ is committed.
# Drop new downloads in here and run `pnpm images`.
/assets/raw/
