# ─── Neon Postgres ───
# DATABASE_URL is the POOLED connection, used by the app at runtime.
# DIRECT_URL is the DIRECT connection, used by `prisma migrate` only.
# NOTE: strip `channel_binding=require` from the strings Neon hands you —
# Prisma's engine does not support channel binding and fails with P1001.
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ─── Auth ───
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ─── AI (OPTIONAL) ───
# Leave AI_API_KEY blank to run without AI. The matching engine falls back to
# rule-based tiers and reasons, and the UI shows "Showing rule-based ranking".
#
# Provider-neutral: any OpenAI-compatible endpoint works. Switching providers
# is these four values and no code change.
#   OpenRouter  https://openrouter.ai/api/v1   (default; free tier = 50 req/day)
#   Groq        https://api.groq.com/openai/v1 (far more generous free tier —
#                                               better for dev iteration)
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=""

# Rerank: needs reasoning quality + strict JSON. Only 4 OpenRouter :free models
# support structured outputs; this one has 262k context and tool support.
AI_MODEL_REASONING="nvidia/nemotron-3-super-120b-a12b:free"

# Intro emails: small and fast, only needs {subject, body}.
AI_MODEL_FAST="google/gemma-4-26b-a4b-it:free"

# ─── App ───
APP_URL="http://localhost:3000"
